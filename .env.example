# Copiar a .env (ese sí está en .gitignore) y poner los valores del proyecto.
# Sin estas variables la app corre en modo local: localStorage, una sola rifa,
# sin cuentas. Con ellas, cuentas y varias rifas sincronizadas.
#
# Supabase > Project Settings > API. El prefijo VITE_ es obligatorio: Vite
# ignora cualquier otro (NEXT_PUBLIC_, REACT_APP_, etc.).
VITE_SUPABASE_URL=https://xxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_...
BREVO_API_KEY=
BREVO_REMITENTE=
SUPERADMIN_EMAIL=
